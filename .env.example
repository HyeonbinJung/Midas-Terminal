# SEC asks automated clients to identify themselves. Replace with a real contact email.
SEC_USER_AGENT=MidasCapitalResearch/5.1 your_email@example.com
SEC_TIMEOUT_SECONDS=20
SEC_MIN_INTERVAL_SECONDS=0.13

# Research / peer extraction
PEER_CANDIDATE_LIMIT=12
BACKGROUND_CELL_CHARS=900
REVENUE_GROWTH_HIGHLIGHT_PCT=20
CATALYST_MAX_ROWS=5
RISK_MAX_ROWS=6
HIGHLIGHT_MAX_ROWS=5
# Maximum rule-based financial commentary lines inserted below each stock-pitch table.
FINANCIAL_COMMENT_MAX=10
MARKET_TIMEOUT_SECONDS=50
RESEARCH_COMPONENT_TIMEOUT_SECONDS=75
TRANSLATION_TIMEOUT_SECONDS=300

# In-process cache TTLs (seconds)
MARKET_CACHE_SECONDS=60
RESEARCH_CACHE_SECONDS=900
PEER_CACHE_SECONDS=3600
SEC_CACHE_SECONDS=86400
NEWS_CACHE_SECONDS=300

# DOCX worker control / cleanup
REPORT_CONCURRENCY=2
YAHOO_CONCURRENCY=6
GENERATED_STALE_SECONDS=3600

# News collection
NEWS_PER_KEYWORD=5
NEWS_LOOKBACK_HOURS=24
GOOGLE_RESULTS_TO_SCAN=40
US_NEWS_PER_KEYWORD=5
US_NEWS_LOOKBACK_HOURS=24
US_GOOGLE_RESULTS_TO_SCAN=40

# Shared virtual portfolio (F7)
PORTFOLIO_TRADE_PASSWORD=3824
PORTFOLIO_INITIAL_CASH=1000000
# Optional absolute path. Default: ./data/midas_portfolio.sqlite3
# PORTFOLIO_DB_PATH=C:/path/to/midas_portfolio.sqlite3

# v5.11 virtual execution simulator
PORTFOLIO_MAX_PARTICIPATION=0.05
